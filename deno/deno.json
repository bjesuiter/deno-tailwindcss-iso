{
    "name": "@bjesuiter/deno-tailwindcss-iso",
    "version": "1.0.5-poc.1",
    "description": "A plugin for generating tailwind css and extracting classes uniformly in deno",
    "license": "MIT",
    "exports": {
        ".": "./src/index.js"
    },
    "imports": {
        "wbg:": "./src/deno/oxide/tailwindcss_oxide.js",
        "tailwindcss": "npm:tailwindcss@^3.0.0 || ^4.0.0"
    },
    "tasks": {
        "test:deno": "deno test test/deno",
        "jsr-dry": "deno publish --dry-run --allow-dirty",
        "jsr": "deno publish --allow-dirty"
    },
    "publish": {
        "include": [
            "src/*",
            "LICENSE"
        ],
        "exclude": [
            ".",
            "!dist"
        ]
    },
    "exclude": [
        "node_modules/",
        "dist/"
    ]
}